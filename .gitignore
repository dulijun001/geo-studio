# deps
node_modules/
.pnpm-store/

# build
.next/
# ADR 012: dev/prod build dirs are permanently isolated so `next dev` can never
# clobber the static assets the production `next start` is serving.
.next-dev/
.next-prod/
.next.corrupt.*/
next-env.d.ts
dist/
build/
out/
*.tsbuildinfo

# env
.env
.env.local
.env.*.local
.env.*.bak
.env.bak*
.env.production
.env.ecs-backup-*
!.env.example
!ops/deploy/.env.production.example

# local-only secrets / scratch notes
*.local.md
secrets.local*

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editor
.vscode/
.idea/
*.swp
.DS_Store

# test
coverage/
.nyc_output/

# playwright
test-results/
playwright-report/
playwright/.cache/

# supabase
supabase/.branches
supabase/.temp
supabase/seed.local.sql

# misc
*.local
tmp/
.cache/

# Claude Code local state (per-project handoffs, never share via git)
.claude/

# Sensitive ops files — contain real employee phones, account handles,
# or unredacted KB compliance violations. Never push to remote.
ops/账号注册表.md
ops/账号注册表.xlsx
ops/staff-matrix*.csv
ops/staff-matrix*.xlsx
ops/kb-compliance-report.md

# Real data goes in data/. Only the .example template is committed.
data/*
!data/*.example

# Content drafts & KB staging — working scratch, kept local (client medical
# content; belongs in the product DB, not the code repo).
/round*.md
/geo_studio_标准GEO文章规范_*.md
docs/kb-staging/
/project.json

# landing 设计参考稿(本地)
/geo-landing.html

# 一次性调试脚本(D43 后约定:_dev 下新增脚本默认不入库,已跟踪的不受影响)
apps/worker/src/_dev/
packages/db/src/_dev/

# other tools' local state
.workbuddy/

# TLS certs / private keys (Tailscale serve, etc.) — never commit
*.key
*.crt
