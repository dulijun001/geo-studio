###############################################################################
# .env.production — 生产环境变量模板
#
# 部署:cp 到 /opt/geo-studio/.env.production,填实际值,chmod 600
# 不要提交到 git!仓库里只放本 .example 模板。
###############################################################################

# ── Supabase(自托管在同一台 ECS 的 Docker)──────────────────────────────────
# self-hosted Supabase 的 URL 通常是 http://localhost:8000(Kong 网关端口),
# 或者直接用 ECS 内网 IP。Public 暴露一律走 Caddy。
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<从 supabase docker .env 复制 ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<从 supabase docker .env 复制 SERVICE_ROLE_KEY>

# Drizzle / pg-boss 走自托管 Supabase 的 Supavisor pooler.
#
# 注意:host 127.0.0.1:5432 由 supabase-pooler 容器占用(supavisor),
# **不是**直连 postgres 容器. user 必须用 `postgres.<POOLER_TENANT_ID>`
# 格式,否则 supavisor 报 "Tenant or user not found",pg-boss / worker /
# 任何用此 URL 的进程全部启动失败. POOLER_TENANT_ID 默认 `your-tenant-id`
# (见 /opt/supabase/docker/.env). 密码与 POSTGRES_PASSWORD 一致.
#
# 2026-05-13 P0 修复:旧版误写为 postgres.studio,导致 worker 一直起不来.
DATABASE_URL=postgresql://postgres.your-tenant-id:<DOCKER_POSTGRES_PASSWORD>@127.0.0.1:5432/postgres

# ── 火山方舟(豆包 Pro,合规审查 + AI 起草)───────────────────────────────────
ARK_API_KEY=<volcengine ark api key>
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_PRO=ep-2026...           # 你火山方舟控制台的 Endpoint ID

# 兜底 OpenAI(英文 / 备份)。可空。
OPENAI_API_KEY=

# ── 员工端 session(HMAC)─────────────────────────────────────────────────────
# 32+ 字符的随机字符串,丢失 = 所有员工 session 失效(无大碍,重新登录即可)
STAFF_SESSION_SECRET=<openssl rand -hex 32>

# ── 阿里云 SMS(W8 验收后启用,前期先 dev passcode)──────────────────────────
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_LOGIN=

# ── 反爬代理池(V2,先空)────────────────────────────────────────────────────
PROXY_POOL_ENDPOINT=
PROXY_POOL_USER=
PROXY_POOL_PASS=

# ── Playwright ─────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=1

# ── 监控 / 错误上报(可选,前期可空)─────────────────────────────────────────
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=

# ── 公网入口 URL(中间件、邮件、回调用)──────────────────────────────────────
# 备案前:用 IP + 9443
NEXT_PUBLIC_APP_URL=https://47.98.131.138:9443
# 备案后:改成 https://dulijun.icu

NODE_ENV=production
