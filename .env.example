# ====== Supabase ======
# Get from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # worker-only, NEVER expose to web client
DATABASE_URL=postgresql://postgres:...@db.xxxxx.supabase.co:5432/postgres

# ====== Volcengine Ark (Doubao LLM) ======
# Get from https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Main endpoint — used for variant generation (writing-heavy workload).
# Recommended: bind to doubao-seed-2-0-pro or latest pro.
ARK_MODEL_PRO=doubao-seed-1-6-pro-250815
# Reasoning endpoint — used for compliance LLM review + AI compliance rewrite
# (analyze-then-decide workloads). Recommended: bind to doubao-seed-1-6-thinking.
# Optional: falls back to ARK_MODEL_PRO when empty so existing deploys keep working.
ARK_MODEL_THINKING=
# Fast / cheap endpoint — citation rewrite + short surgical edits.
ARK_MODEL_FAST=doubao-1-5-pro-32k-250115

# ====== OpenAI (fallback) ======
OPENAI_API_KEY=

# ====== Worker / Playwright ======
PROXY_POOL_ENDPOINT=           # e.g. LunaProxy gateway
PROXY_POOL_USER=
PROXY_POOL_PASS=
PLAYWRIGHT_HEADLESS=true

# ====== Staff session (/staff mobile portal) ======
# HMAC secret for the geo_staff_session cookie. Must be >= 32 random chars.
# Generate: `openssl rand -hex 32`
STAFF_SESSION_SECRET=

# ====== SMS (Aliyun) ======
# Currently unused — W5 uses admin-generated passcodes in-app.
# Wire these when migrating to real SMS OTP in V1 final.
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_LOGIN=

# ====== Observability ======
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=geo-studio

# ====== App ======
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
