# ====== Supabase ======
# Get from https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # worker-only, NEVER expose to web client
DATABASE_URL=postgresql://postgres:...@db.xxxxx.supabase.co:5432/postgres

# ====== Volcengine Ark (Doubao LLM) ======
# Get from https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Main endpoint — used for variant generation (writing-heavy workload).
# Recommended: bind to doubao-seed-2-0-pro or latest pro.
ARK_MODEL_PRO=doubao-seed-1-6-pro-250815
# Reasoning endpoint — used for compliance LLM review + AI compliance rewrite
# (analyze-then-decide workloads). Recommended: bind to doubao-seed-1-6-thinking.
# Optional: falls back to ARK_MODEL_PRO when empty so existing deploys keep working.
ARK_MODEL_THINKING=
# Fast / cheap endpoint — citation rewrite + short surgical edits.
ARK_MODEL_FAST=doubao-1-5-pro-32k-250115

# ====== OpenAI (fallback) ======
OPENAI_API_KEY=

# ====== Worker / Playwright ======
PROXY_POOL_ENDPOINT=           # e.g. LunaProxy gateway
PROXY_POOL_USER=
PROXY_POOL_PASS=
PLAYWRIGHT_HEADLESS=true

# ====== Staff session (/staff mobile portal) ======
# HMAC secret for the geo_staff_session cookie. Must be >= 32 random chars.
# Generate: `openssl rand -hex 32`
STAFF_SESSION_SECRET=

# ====== SMS (Aliyun) ======
# Currently unused — W5 uses admin-generated passcodes in-app.
# Wire these when migrating to real SMS OTP in V1 final.
ALIYUN_SMS_ACCESS_KEY=
ALIYUN_SMS_ACCESS_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_LOGIN=

# ====== Observability ======
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=geo-studio

# ====== App ======
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ====== Email (SMTP — 阿里云邮件推送 DirectMail) ======
# V1.12.1: 不配置时邮件静默丢弃(delivered=false + reportEvent),配齐即真发。
# 阿里云 DirectMail: SMTP_HOST=smtpdm.aliyun.com SMTP_PORT=465(SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ====== Worker / Tracker ======
# CloakBrowser 持久化 userDataDir(登录 cookie),不设则用 ~/.cache/geo-tracker/<engine>
GEO_DOUBAO_USERDATA=
GEO_YUANBAO_USERDATA=
GEO_DEEPSEEK_USERDATA=
# ECS 上固定 :99(D30 — CloakBrowser fingerprint 与 display 关联,严禁随机分配)
DISPLAY=
# headful 默认;ECS Xvfb 环境保持 false
PLAYWRIGHT_HEADLESS=false

# ====== Knowledge Base / 引用白名单 ======
# KB 根目录(默认 ~/Workspace/songshu-knowledge-base,ECS 为 /opt/kb/松鼠)
KNOWLEDGE_BASE_ROOT=
# verified citations 白名单 JSON 路径(不设走内置)
WHITELIST_JSON_PATH=

# ====== Internal API(web ↔ worker 内部调用) ======
# worker 调 web 内部 API 的 base(默认 http://127.0.0.1:3000)
INTERNAL_API_BASE=
# 内部 draft API 的共享密钥,防止公网直接调用
DRAFT_INTERNAL_SECRET=

# ====== Dev-only(生产禁用) ======
# /login/dev 一键登录用(NODE_ENV=production 时路由硬 404,无任何 env 可开启)
DEV_ADMIN_EMAIL=
DEV_ADMIN_USER_ID=
