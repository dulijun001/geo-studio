{
  "name": "geo-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant Generative Engine Optimization platform",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @geo/web dev",
    "dev:worker": "pnpm --filter @geo/worker dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @geo/db generate",
    "db:migrate": "pnpm --filter @geo/db migrate",
    "db:studio": "pnpm --filter @geo/db studio",
    "db:seed": "pnpm --filter @geo/db seed",
    "db:test-rls": "pnpm --filter @geo/db test-rls",
    "db:test-auth": "pnpm --filter @geo/db test-auth",
    "db:test-tenant": "pnpm --filter @geo/db test-tenant",
    "db:dev-link": "pnpm --filter @geo/db dev-link",
    "db:test-content": "pnpm --filter @geo/db test-content",
    "db:test-discoverability": "pnpm --filter @geo/db test-discoverability"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  }
}
