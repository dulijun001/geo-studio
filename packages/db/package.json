{
  "name": "@geo/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "studio": "drizzle-kit studio",
    "push": "drizzle-kit push",
    "seed": "tsx --env-file=../../.env src/seed/index.ts",
    "test-rls": "tsx --env-file=../../.env src/_test/rls.ts",
    "test-auth": "tsx --env-file=../../.env src/_test/auth-flow.ts",
    "test-tenant": "tsx --env-file=../../.env src/_test/tenant-flow.ts",
    "test-content": "tsx --env-file=../../.env src/_test/content-flow.ts",
    "test-compliance-scan": "tsx --env-file=../../.env src/_test/compliance-scan.ts",
    "test-compliance-flow": "tsx --env-file=../../.env src/_test/compliance-flow.ts",
    "test-compliance-llm": "tsx --env-file=../../.env src/_test/compliance-llm.ts",
    "test-variant-flow": "tsx --env-file=../../.env src/_test/variant-flow.ts",
    "test-dispatch": "tsx --env-file=../../.env src/_test/dispatch.ts",
    "test-discoverability": "tsx --env-file=../../.env src/_test/discoverability.ts",
    "test-schema": "tsx --env-file=../../.env src/_test/schema-generators.ts",
    "test-artifacts": "tsx --env-file=../../.env src/_test/artifact-generators.ts",
    "test-uniqueness": "tsx --env-file=../../.env src/_test/uniqueness-eeat.ts",
    "dev-link": "tsx --env-file=../../.env src/_dev/mint-link.ts",
    "dev-clear-variants": "tsx --env-file=../../.env src/_dev/clear-variants.ts",
    "dev-test-doubao": "tsx --env-file=../../.env src/_dev/test-doubao.ts",
    "dev-seed-w5": "tsx --env-file=../../.env src/_dev/seed-w5.ts",
    "dev-seed-w6": "tsx --env-file=../../.env src/_dev/seed-w6.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.4",
    "pg-boss": "^10.1.6",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@geo/geo-core": "workspace:*",
    "@geo/shared": "workspace:*",
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
