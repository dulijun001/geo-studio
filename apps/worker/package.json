{
  "name": "@geo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "dev-smoke-tracker": "tsx src/trackers/_dev/smoke.ts",
    "doubao:login": "tsx src/trackers/_dev/doubao-login.ts",
    "doubao:probe": "tsx src/trackers/_dev/probe-dom.ts",
    "yuanbao:login": "tsx src/trackers/_dev/yuanbao-login.ts",
    "yuanbao:probe": "tsx src/trackers/_dev/probe-yuanbao.ts",
    "deepseek:login": "tsx src/trackers/_dev/deepseek-login.ts",
    "deepseek:probe": "tsx src/trackers/_dev/probe-deepseek.ts",
    "dev-regen-discoverability": "tsx --env-file=../../.env src/_dev/regen-discoverability.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@geo/db": "workspace:*",
    "@geo/geo-core": "workspace:*",
    "@geo/shared": "workspace:*",
    "@supabase/supabase-js": "^2.46.1",
    "dotenv": "^16.4.5",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pg-boss": "^10.1.6",
    "playwright": "^1.48.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
